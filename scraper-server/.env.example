# Port to run the scraper Express service
PORT=3001

# Shared Secret Key between Cloudflare Pages and Azure Scraper Server
# Must match SCRAPER_API_SECRET set in Cloudflare Pages Environment Variables
SCRAPER_API_SECRET=your_super_secret_scraper_key_here

# Cloudflare WARP SOCKS5 proxy on localhost (optional, recommended on Azure VM)
# Set to socks5://127.0.0.1:40000 if WARP is running in proxy mode
WARP_PROXY=socks5://127.0.0.1:40000

# Cache duration in minutes (default 30)
CACHE_TTL_MINUTES=30
